{
    "name": "switch/foundation",
    "description": "The Swiss Army knife foundation for the Switch Framework: Auth, Cache, Storage, Image, Mailer, Queue, and API Resources",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Celio Natti",
            "email": "celionatti@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-server-handler": "^1.0",
        "psr/container": "^1.0 || ^2.0"
    },
    "suggest": {
        "switch/database": "To use Database cache, queue, and user models",
        "switch/session": "For session-based authentication guard",
        "switch/view": "For rendering template-based Mailables",
        "ext-gd": "For image resizing, cropping, and format conversion",
        "ext-redis": "For Redis caching and queues"
    },
    "autoload": {
        "psr-4": {
            "Switch\\Foundation\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Switch\\Foundation\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
